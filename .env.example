# ============================================================
# Patinaskins — environment template
# Copy to .env (or set these in your host, e.g. Vercel) and fill in real values.
# Never commit real secrets — .env and .env*.local are gitignored.
# ============================================================

# ============================================================
# Database — PostgreSQL (Neon in production, Prisma Postgres locally)
# ============================================================
# App runtime + Prisma CLI connection (pooled).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection — used by migrations and seed.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ============================================================
# Auth
# ============================================================
# Random 32+ byte secret. Generate: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"
# Optional: npx prisma db seed creates this admin when both are set (password 12+ characters).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ============================================================
# App Config
# ============================================================
# Public base URL, no trailing slash. Used in emails, SEO, sitemap.
NEXT_PUBLIC_SITE_URL="https://patinaskins.com"
# Absolute base URL used for Steam sign-in, payment return and webhook URLs. Defaults to NEXT_PUBLIC_SITE_URL.
# Must be the main domain, never a *.vercel.app preview URL.
APP_URL="https://patinaskins.com"

# ============================================================
# Cloudflare R2 — storage for images uploaded in the admin (banners, pages).
# Skin images are served from the Steam CDN and are not stored here.
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# ============================================================
# SMTP — transactional emails (welcome, order confirmation,
# invoice, trade offer and refund updates, password reset, contact form)
# Provider: Spacemail. Host mail.spacemail.com, port 587 (STARTTLS)
# or 465 (implicit TLS). Username/password are the mailbox credentials.
# ============================================================
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
# "true" only for port 465 (implicit TLS); leave "false" for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER="youremail@example.com"
SMTP_PASSWORD="your-mailbox-password"
# From address must belong to the authenticated mailbox's domain.
SMTP_FROM="Patinaskins <youremail@example.com>"
# Where contact-form submissions land and where customers reply.
SMTP_REPLY_TO="youremail@example.com"

# ============================================================
# Payments — see "Payments" in README.md
# PAYMENT_PROVIDER picks the provider registered in src/lib/payments/provider.ts.
#   none  no card provider connected: checkout answers 503 PAYMENTS_NOT_CONNECTED and creates no order.
#   mock  local testing only: a test payment page at /checkout/mock-pay with Pay / Fail buttons.
#         Refused unless NODE_ENV is not "production" AND PAYMENT_MOCK_ENABLED=true.
# Provider webhooks arrive at https://<your-domain>/api/webhooks/payment/<provider>
# ============================================================
PAYMENT_PROVIDER="none"
PAYMENT_MOCK_ENABLED="false"

# ============================================================
# Item supplier (api.sih.market) — catalogue sync and delivery
# Never shown to customers. Validated in src/lib/env.ts.
# ============================================================
SIH_API_KEY=""
SIH_API_BASE="https://api.sih.market/api/v1"
SIH_APP_ID="730"
# Shared secret embedded in the SIH webhook URL: https://<your-domain>/api/webhooks/sih?secret=<value>
# Register it with: npm run sih:webhook
SIH_WEBHOOK_SECRET=""
# "true" sends test orders to the supplier (no real spend). Keep "false" in production.
SIH_TEST_MODE="false"
# Storefront price = max(cost * (1 + SIH_MARGIN), cost + SIH_MIN_MARGIN_ABS), rounded up. Defaults live in src/config/catalog.ts.
SIH_MARGIN="0.07"
SIH_MIN_MARGIN_ABS="0.1"
# Re-price at checkout when the live supplier cost grew by more than this fraction.
SIH_PRICE_TOLERANCE="0.03"
# Alert when the supplier balance (USD) falls below this.
SIH_LOW_BALANCE_THRESHOLD="100"
# Local development only: read the catalogue from a JSON file instead of the API (npm run catalog:sync).
SIH_FIXTURE_FILE=""

# ============================================================
# Steam
# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey) to show the
# linked account's name and avatar. Sign-in works without it.
# ============================================================
STEAM_API_KEY=""

# ============================================================
# Cron jobs (vercel.json) — Bearer token Vercel sends to /api/cron/*
# Generate: openssl rand -hex 32
# ============================================================
CRON_SECRET=""

# ============================================================
# Operational alerts (optional). Without them, alerts go to the server log.
# ============================================================
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
